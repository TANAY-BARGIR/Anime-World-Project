<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= anime.name %> - Anime World</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <style>
      /* --- RESET & VARIABLES --- */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Roboto", sans-serif;
        background-color: #1a1a1d; /* Fallback color */
        color: #ffffff;
        min-height: 100vh;
        overflow-x: hidden;
      }

      /* --- BACKGROUND BLUR EFFECT --- */
      /* We use the anime image as a massive blurred background */
      .bg-layer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url("<%= anime.image %>") no-repeat center center/cover;
        filter: blur(20px) brightness(0.4); /* Heavy blur + Darken */
        z-index: -1;
        transform: scale(1.1); /* Prevent white edges from blur */
      }

      /* --- MAIN CONTAINER --- */
      .container {
        max-width: 1200px;
        margin: 0 auto;
        padding: 40px 20px;
        display: grid;
        grid-template-columns: 250px 1fr 300px; /* Poster | Main | Stats */
        gap: 40px;
        align-items: start; /* Align tops */
      }

      /* --- COLUMN 1: POSTER --- */
      .poster-card img {
        width: 100%;
        border-radius: 8px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
      }

      /* --- COLUMN 2: MAIN INFO --- */
      .main-info h1 {
        font-size: 3rem;
        font-weight: 700;
        margin-bottom: 15px;
      }

      /* The small badges (HD, 18+, TV) */
      .badges {
        display: flex;
        gap: 10px;
        margin-bottom: 25px;
        font-size: 0.8rem;
        font-weight: bold;
      }
      .badge {
        background: rgba(255, 255, 255, 0.2);
        padding: 2px 6px;
        border-radius: 3px;
      }
      .badge.quality {
        background: #a4c639;
        color: black;
      } /* HD Green */

      /* Watch Now Button */
      .watch-btn {
        display: inline-block;
        background-color: #00e676; /* Bright Green */
        color: #000;
        padding: 12px 30px;
        border-radius: 30px;
        text-decoration: none;
        font-weight: bold;
        font-size: 1.1rem;
        margin-bottom: 30px;
        transition: transform 0.2s;
      }
      .watch-btn:hover {
        transform: scale(1.05);
        background-color: #00c853;
      }
      .watch-btn i {
        margin-right: 8px;
      }

      .description {
        line-height: 1.6;
        color: #ddd;
        font-size: 0.95rem;
      }

      /* --- COLUMN 3: SIDEBAR STATS --- */
      .sidebar-stats {
        background: rgba(0, 0, 0, 0.3); /* Slight background for readability */
        padding: 20px;
        border-radius: 10px;
        font-size: 0.9rem;
      }

      .stat-row {
        margin-bottom: 12px;
      }
      .stat-row strong {
        color: #aaa;
        display: inline-block;
        min-width: 80px;
      }

      /* Genre Tags (Pill Shape) */
      .genres-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 5px;
      }
      .genre-tag {
        border: 1px solid #aaa;
        border-radius: 15px;
        padding: 4px 10px;
        font-size: 0.75rem;
        text-decoration: none;
        color: white;
        transition: 0.3s;
      }
      .genre-tag:hover {
        background: white;
        color: black;
      }
      /* --- CHARACTER BUTTONS --- */
      .char-section {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid rgba(255, 255, 255, 0.1);
      }

      .char-section h3 {
        margin-bottom: 15px;
        font-size: 1.5rem;
        color: #fff;
      }

      .char-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 15px;
      }

      .char-btn {
        display: inline-block;
        padding: 10px 20px;
        background: rgba(255, 255, 255, 0.1); /* Glass effect */
        border: 1px solid rgba(255, 255, 255, 0.2);
        border-radius: 8px;
        color: #ddd;
        text-decoration: none;
        font-size: 0.95rem;
        transition: all 0.3s ease;
      }

      .char-btn:hover {
        background: #ff4500; /* Orange highlight on hover */
        color: white;
        border-color: #ff4500;
        transform: translateY(-3px);
        box-shadow: 0 5px 15px rgba(255, 69, 0, 0.4);
      }
      /* --- RESPONSIVE (Mobile) --- */
      @media (max-width: 900px) {
        .container {
          grid-template-columns: 1fr; /* Stack everything */
        }
        .poster-card {
          max-width: 200px;
          margin: 0 auto;
        }
        .main-info {
          text-align: center;
        }
        .badges {
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg-layer"></div>

    <div class="container">
      <div class="poster-card">
        <img src="<%= anime.image %>" alt="<%= anime.name %> Poster" />
      </div>

      <div class="main-info">
        <div style="font-size: 0.9rem; color: #bbb; margin-bottom: 10px">
          Home &bull; TV &bull; <%= anime.name %>
        </div>

        <h1><%= anime.name %></h1>

        <div class="badges">
          <span class="badge">PG-13</span>
          <span class="badge quality">HD</span>
          <span class="badge"><%= anime.type %></span>
          <span class="badge"><%= anime.episodes %> eps</span>
        </div>

        <a href="#" class="watch-btn">
          <i class="fas fa-play"></i> Watch now
        </a>

        <div class="description"><%= anime.description %></div>
        <div class="char-section">
          <h3>Main Characters</h3>
          <div class="char-grid">
            <% if (anime.characters && anime.characters.length > 0) { %> <%
            anime.characters.forEach(character => { %>
            <a href="/character/<%= character %>" class="char-btn">
              <i class="fas fa-user"></i> <%= character %>
            </a>
            <% }) %> <% } else { %>
            <p style="color: #777">No characters listed yet.</p>
            <% } %>
          </div>
        </div>
        <br />
        <a href="/" style="color: #00e676; text-decoration: none"
          >&larr; Back to Home</a
        >
      </div>

      <div class="sidebar-stats">
        <div class="stat-row">
          <strong>Japanese:</strong> <%= anime.japanese %>
        </div>
        <div class="stat-row"><strong>Type:</strong> <%= anime.type %></div>
        <div class="stat-row"><strong>Aired:</strong> <%= anime.aired %></div>
        <div class="stat-row"><strong>Status:</strong> <%= anime.status %></div>
        <div class="stat-row"><strong>Score:</strong> <%= anime.rating %></div>
        <div class="stat-row">
          <strong>Studios:</strong> <%= anime.studios %>
        </div>

        <div class="stat-row" style="margin-top: 20px">
          <strong>Genres:</strong>
          <div class="genres-list">
            <% anime.genres.forEach(genre => { %>
            <span class="genre-tag"><%= genre %></span>
            <% }) %>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
