<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= character.name %> - Details</title>

    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css"
    />

    <style>
      /* --- REUSING YOUR DARK THEME VARIABLES --- */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      body {
        font-family: "Roboto", sans-serif;
        background-color: #121212;
        color: #fff;
        min-height: 100vh;
      }

      /* --- BLURRED BACKGROUND --- */
      .bg-layer {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: url("<%= character.image %>") no-repeat center center/cover;
        filter: blur(25px) brightness(0.3);
        z-index: -1;
      }

      /* --- LAYOUT CONTAINER --- */
      .container {
        max-width: 1100px;
        margin: 60px auto;
        padding: 20px;
        display: grid;
        grid-template-columns: 300px 1fr; /* Image Column | Info Column */
        gap: 50px;
      }

      /* --- LEFT COLUMN: IMAGE & BASE STATS --- */
      .char-card {
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        overflow: hidden;
        backdrop-filter: blur(10px);
      }

      .char-img {
        width: 100%;
        height: auto;
        display: block;
        border-bottom: 2px solid #ff4500;
      }

      .base-stats {
        padding: 20px;
      }

      .stat-row {
        display: flex;
        justify-content: space-between;
        padding: 10px 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        font-size: 0.9rem;
      }
      .stat-row:last-child {
        border-bottom: none;
      }
      .stat-label {
        color: #aaa;
      }

      /* --- RIGHT COLUMN: INFO & SPECIALS --- */
      .char-header h1 {
        font-size: 3.5rem;
        font-weight: 700;
        margin-bottom: 10px;
        text-shadow: 2px 2px 5px rgba(0, 0, 0, 0.5);
      }

      .char-anime-title {
        color: #ff4500;
        font-size: 1.2rem;
        margin-bottom: 25px;
        text-transform: uppercase;
        letter-spacing: 2px;
      }

      .bio-box {
        background: rgba(0, 0, 0, 0.3);
        padding: 25px;
        border-left: 4px solid #ff4500;
        margin-bottom: 30px;
        line-height: 1.8;
        color: #ddd;
        border-radius: 0 8px 8px 0;
      }

      /* --- DYNAMIC SPECIAL STATS --- */
      .special-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
      }

      .special-card {
        background: rgba(255, 69, 0, 0.1);
        border: 1px solid rgba(255, 69, 0, 0.3);
        padding: 15px;
        border-radius: 8px;
      }
      .special-label {
        color: #ff4500;
        font-size: 0.8rem;
        text-transform: uppercase;
        font-weight: bold;
      }
      .special-value {
        font-size: 1.1rem;
        margin-top: 5px;
      }

      /* --- TAGS --- */
      .tags-container {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
      }
      .tag {
        background: #333;
        padding: 5px 12px;
        border-radius: 20px;
        font-size: 0.85rem;
        color: #aaa;
        border: 1px solid #444;
      }

      .back-btn {
        display: inline-block;
        margin-top: 40px;
        color: #aaa;
        text-decoration: none;
        transition: 0.3s;
      }
      .back-btn:hover {
        color: white;
      }

      .fav-btn {
        background: #e91e63; /* Pink color for love */
        color: white;
        border: none;
        padding: 12px 25px;
        border-radius: 30px;
        font-size: 1rem;
        cursor: pointer;
        transition: all 0.3s;
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .fav-btn:hover {
        background: #c2185b;
        transform: scale(1.05);
        box-shadow: 0 0 15px rgba(233, 30, 99, 0.6);
      }

      @media (max-width: 768px) {
        .container {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
    <div class="bg-layer"></div>

    <div class="container">
      <div class="char-card">
        <img
          src="<%= character.image %>"
          alt="<%= character.name %>"
          class="char-img"
        />

        <div class="base-stats">
          <div class="stat-row">
            <span class="stat-label">Gender</span>
            <span><%= character.gender %></span>
          </div>
          <div class="stat-row">
            <span class="stat-label">Blood Type</span>
            <span><%= character.blood_type %></span>
          </div>
          <div class="stat-row">
            <span class="stat-label">Birthday</span>
            <span><%= character.birthday %></span>
          </div>
          <div class="stat-row">
            <span class="stat-label">Hair Color</span>
            <span><%= character.hair_color %></span>
          </div>
        </div>
      </div>

      <div class="right-content">
        <div class="char-header">
          <h1><%= character.name %></h1>
          <div class="char-anime-title"><%= character.anime %></div>
        </div>

        <div class="bio-box"><%= character.description %></div>

        <% if (character.special_attributes) { %>
        <div class="special-grid">
          <% for (const [key, value] of
          Object.entries(character.special_attributes)) { %>
          <div class="special-card">
            <div class="special-label"><%= key %></div>
            <div class="special-value"><%= value %></div>
          </div>
          <% } %>
        </div>
        <% } %>

        <div class="tags-container">
          <% if (character.tags) { %> <% character.tags.forEach(tag => { %>
          <span class="tag">#<%= tag %></span>
          <% }) %> <% } %>
        </div>

        <a href="javascript:history.back()" class="back-btn">
          <i class="fas fa-arrow-left"></i> Back to Anime Info
        </a>
        <form
          action="/favourites"
          method="POST"
          style="display: inline-block; margin-right: 15px"
        >
          <input type="hidden" name="name" value="<%= character.name %>" />
          <input type="hidden" name="anime" value="<%= character.anime %>" />
          <input type="hidden" name="image" value="<%= character.image %>" />

          <button type="submit" class="fav-btn">
            <i class="fas fa-heart"></i> Add to Favorites
          </button>
        </form>
      </div>
    </div>
  </body>
</html>
