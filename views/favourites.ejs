<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Favourites</title>
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Roboto', sans-serif;
            background-color: #121212;
            color: white;
            padding: 40px;
        }
        h1 { text-align: center; margin-bottom: 40px; color: #e91e63; }
        
        .fav-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
            gap: 20px;
            max-width: 1000px;
            margin: 0 auto;
        }

        .fav-card {
            background: #1e1e1e;
            border-radius: 10px;
            overflow: hidden;
            text-align: center;
            transition: transform 0.3s;
        }
        .fav-card:hover { transform: translateY(-5px); }

        .fav-card img {
            width: 100%;
            height: 250px;
            object-fit: cover;
        }

        .fav-info { padding: 15px; }
        .fav-name { font-weight: bold; font-size: 1.1rem; display: block; margin-bottom: 5px; }
        .fav-anime { color: #888; font-size: 0.9rem; }
        
        .empty-msg { text-align: center; color: #666; font-size: 1.2rem; margin-top: 50px; }
        .back-link { display: block; text-align: center; margin-top: 40px; color: #aaa; text-decoration: none; }
    </style>
</head>
<body>

    <h1><i class="fas fa-heart"></i> My Collections</h1>

    <% if (favourites.length > 0) { %>
        <div class="fav-grid">
            <% favourites.forEach(char => { %>
                <div class="fav-card">
                    <img src="<%= char.image %>" alt="<%= char.name %>">
                    <div class="fav-info">
                        <span class="fav-name"><%= char.name %></span>
                        <span class="fav-anime"><%= char.anime %></span>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <p class="empty-msg">You haven't added any characters yet.</p>
    <% } %>

    <a href="/" class="back-link">Back to Home</a>

</body>
</html>